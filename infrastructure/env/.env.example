# DEVELOPMENT ONLY. Copy to .env and replace every value marked CHANGE-ME before use.
# ──────────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker Compose default) ──────────────────────────────────────────
POSTGRES_DB=policymesh
POSTGRES_USER=policymesh
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MySQL (Alternative Local Dev: Host=localhost, Port=3306) ─────────────────────
# If running against local MySQL instead of PostgreSQL container, set:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/policymesh?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=admin

# ── Redis ─────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9092

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────────
BACKEND_PORT=8080

# REQUIRED: JWT signing secret — MUST be at least 32 characters.
JWT_SECRET=change-this-development-secret-at-least-32-characters

# Token TTL in milliseconds (default 1 hour)
JWT_EXPIRATION_MS=3600000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis cache for compiled policies (true = use Redis, false = in-process only)
POLICYMESH_REDIS_ENABLED=true

# Kafka async event publishing (false = synchronous decisions only; recommended for local dev)
POLICYMESH_KAFKA_ENABLED=false

# Auto-seed demo data on backend startup (true = seed once if DB is empty)
POLICYMESH_DEMO_SEED=false

# Enable the POST /api/v1/dev/seed endpoint (true = ADMIN can trigger seed via API)
POLICYMESH_DEMO_SEED_ENDPOINT=true

# AI classification mode: local (heuristic, no API key needed) or remote (FastAPI service)
AI_SERVICE_MODE=local

# ── AI Service (FastAPI / Python) ─────────────────────────────────────────────────
AI_SERVICE_PORT=8000
POLICYMESH_BACKEND_URL=http://backend:8080
AI_SERVICE_URL=http://ai-service:8000
APP_ENV=development
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
INTERNAL_API_KEY=
MAX_FIELDS=100
MAX_SAMPLE_VALUE_LENGTH=500
MAX_REQUEST_BYTES=1048576

# ── Frontend ──────────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173

