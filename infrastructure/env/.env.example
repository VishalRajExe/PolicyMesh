# DEVELOPMENT ONLY. Copy to .env and replace every value marked CHANGE-ME before use.
# ──────────────────────────────────────────────────────────────────────────────────

# ── MySQL (Primary Database) ──────────────────────────────────────────────────────
MYSQL_DATABASE=policymeshdb
MYSQL_ROOT_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=policymeshdb
DB_USERNAME=root
DB_PASSWORD=change-me-db-password

# ── Redis ─────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POLICY_TTL_SECONDS=600

# ── Kafka ─────────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=9092

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=change-this-development-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POLICYMESH_REDIS_ENABLED=true
POLICYMESH_KAFKA_ENABLED=false
POLICYMESH_DEMO_SEED=false
POLICYMESH_DEMO_SEED_ENDPOINT=true
AI_SERVICE_MODE=local

# ── AI Service (FastAPI / Python) ─────────────────────────────────────────────────
AI_SERVICE_PORT=8000
POLICYMESH_BACKEND_URL=http://backend:8080
AI_SERVICE_URL=http://ai-service:8000
APP_ENV=development
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
INTERNAL_API_KEY=
MAX_FIELDS=100
MAX_SAMPLE_VALUE_LENGTH=500
MAX_REQUEST_BYTES=1048576

# ── Frontend ──────────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
