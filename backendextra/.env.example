# Copy this file to .env and fill in real values for local development.
# Never commit a populated .env file.

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/policymesh
DB_USERNAME=policymesh
DB_PASSWORD=policymesh

# ---------- Redis (cache only, not source of truth) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# ---------- Kafka (async events, not required for correctness) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# ---------- JWT ----------
# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# ---------- AI classification service (optional) ----------
# Leave blank to use the built-in local mock classifier.
AI_SERVICE_URL=

# ---------- Policy engine ----------
# ALLOW or DENY - what happens when no policy applies to a jurisdiction/dataClass pair
POLICY_DEFAULT_DECISION=ALLOW

# ---------- Server ----------
SERVER_PORT=8080

# ---------- Seed demo data on startup (dev only) ----------
POLICYMESH_SEED_ENABLED=false
