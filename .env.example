# PolicyMesh Environment Configuration Template
# Copy this file to .env and set your development values. Never commit .env with real secrets.

# ── MySQL Database ─────────────────────────────────────────────────────────────
# Local development on PC:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=policymeshdb
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# Inside Docker Compose:
# DB_HOST=mysql
MYSQL_DATABASE=policymeshdb
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POLICY_TTL_SECONDS=600
POLICYMESH_REDIS_ENABLED=true

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
POLICYMESH_KAFKA_ENABLED=false

# ── Backend (Spring Boot) ──────────────────────────────────────────────────────
BACKEND_PORT=8080
SERVER_PORT=8080
JWT_SECRET=change-this-development-secret-at-least-32-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
POLICYMESH_DEMO_SEED=false
POLICYMESH_DEMO_SEED_ENDPOINT=true

# ── AI Service (FastAPI / Python) ──────────────────────────────────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_MODE=local
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
