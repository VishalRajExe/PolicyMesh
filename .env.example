# ==============================================================================
# PolicyMesh — Environment Configuration Reference & Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.
# For production deployments, inject these variables into Render, Vercel, and Aiven.

# ── 1. Database Configuration (Aiven Cloud MySQL or Local MySQL) ──────────────
# Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=policymeshdb
DB_USERNAME=root
DB_PASSWORD=your_local_password
DB_USE_SSL=false
DB_SSL_MODE=PREFERRED

# Aiven Cloud MySQL (Production on Render):
# DB_HOST=mysql-xxxx-project.aivencloud.com
# DB_PORT=18342
# DB_NAME=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_USE_SSL=true
# DB_SSL_MODE=REQUIRED
# Alternatively, supply the full JDBC URI:
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-xxxx-project.aivencloud.com:18342/defaultdb?sslMode=REQUIRED&serverTimezone=UTC

# ── 2. Backend API Service (Spring Boot on Render / Local) ────────────────────
PORT=8080
SERVER_PORT=8080
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app
POLICYMESH_DEMO_SEED=false
POLICYMESH_DEMO_SEED_ENDPOINT=true

# ── 3. GitHub API Integration (CI / Commit Analysis) ──────────────────────────
GITHUB_OWNER=VishalRajExe
GITHUB_REPOSITORY=PolicyMesh
# Generate a Personal Access Token with repo / checks / workflow read permissions:
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ── 4. AI Classification Service (FastAPI on Render / Local) ──────────────────
AI_SERVICE_PORT=8000
AI_SERVICE_MODE=remote
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=mock
# For OpenAI / OpenAI-compatible / Anthropic / Gemini:
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ── 5. Redis (Optional Accelerator for Policy Caching) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POLICY_TTL_SECONDS=600
POLICYMESH_REDIS_ENABLED=false

# ── 6. Kafka (Optional Async Notification Stream) ─────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
POLICYMESH_KAFKA_ENABLED=false

# ── 7. Frontend (React + Vite on Vercel) ──────────────────────────────────────
# Point Vercel build to your live Render backend:
VITE_API_BASE_URL=https://policymesh-backend.onrender.com/api/v1
# VITE_API_URL=https://policymesh-backend.onrender.com
FRONTEND_PORT=5173